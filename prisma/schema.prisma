generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum PlanCode {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  PAUSED
}

enum TenantRole {
  OWNER
  ADMIN
  AGENT
}

enum AiProvider {
  OPENAI
  GOOGLE
}

enum ChannelType {
  WEB
  WHATSAPP
  INSTAGRAM
  MESSENGER
}

enum ConversationStatus {
  AI_ACTIVE
  HUMAN_HANDOFF
  RESOLVED
}

enum MessageRole {
  USER
  ASSISTANT
  HUMAN_AGENT
  SYSTEM
}

enum DocumentSourceType {
  TEXT
  PDF
  URL
}

enum DocumentStatus {
  PROCESSING
  READY
  ERROR
}

enum AppointmentStatus {
  CONFIRMED
  PENDING
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum NotificationType {
  BOOKING
  CANCELLATION
  RESCHEDULE
  HANDOFF
  REMINDER
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum NotificationStatus {
  SENT
  SIMULATED
  FAILED
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model Plan {
  id                  String   @id @default(cuid())
  code                PlanCode @unique
  name                String
  description         String?
  priceMonthlyCents   Int      @default(0)
  currency            String   @default("MXN")
  mpPlanId            String?
  monthlyMessageLimit Int      @default(500)
  monthlyTokenLimit   Int      @default(500000)
  maxChannels         Int      @default(2)
  maxKnowledgeDocs    Int      @default(10)
  maxTeamMembers      Int      @default(2)
  allowByok           Boolean  @default(false)
  allowGoogleCalendar Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenants Tenant[]
}

model Tenant {
  id                 String             @id @default(cuid())
  name               String
  slug               String             @unique
  customDomain       String?            @unique
  description        String?
  timezone           String             @default("America/Mexico_City")
  email              String?
  phone              String?
  website            String?
  address            String?
  primaryColor       String             @default("#4f46e5")
  logoUrl            String?
  isActive           Boolean            @default(true)
  planId             String
  mpPayerEmail       String?
  mpPreapprovalId    String?            @unique
  subscriptionStatus SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd   DateTime?
  trialEndsAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  plan                     Plan                      @relation(fields: [planId], references: [id])
  memberships              TenantMembership[]
  agentConfig              AgentConfig?
  faqs                     FaqItem[]
  knowledgeDocuments       KnowledgeDocument[]
  knowledgeChunks          KnowledgeChunk[]
  channels                 ChannelConnection[]
  contacts                 Contact[]
  conversations            Conversation[]
  messages                 Message[]
  services                 Service[]
  availabilityRules        AvailabilityRule[]
  availabilityExceptions   AvailabilityException[]
  googleCalendarConnection GoogleCalendarConnection?
  appointments             Appointment[]
  usageRecords             UsageRecord[]
  notificationRule         NotificationRule?
  notificationLogs         NotificationLog[]
  billingEvents            BillingEvent[]
  invitations              TenantInvitation[]
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  passwordHash    String
  isSuperAdmin    Boolean   @default(false)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships           TenantMembership[]
  assignedConversations Conversation[]     @relation("AssignedAgent")
  authTokens            AuthToken[]
}

model TenantMembership {
  id        String     @id @default(cuid())
  tenantId  String
  userId    String
  role      TenantRole @default(AGENT)
  createdAt DateTime   @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

model AgentConfig {
  id                    String     @id @default(cuid())
  tenantId              String     @unique
  agentName             String     @default("Asistente Virtual")
  systemPrompt          String     @default("Eres un asistente virtual amable, claro y profesional. Respondes dudas frecuentes usando únicamente la información del negocio y ayudas a consultar disponibilidad, agendar, reprogramar o cancelar citas.")
  tone                  String     @default("profesional y cercano")
  greetingMessage       String     @default("¡Hola! Soy tu asistente virtual. ¿En qué te puedo ayudar hoy? Puedo resolver tus dudas o ayudarte a agendar una cita.")
  handoffMessage        String     @default("Entendido, estoy transfiriendo tu conversación con un asesor humano del equipo. En breve te atenderán.")
  provider              AiProvider @default(OPENAI)
  model                 String     @default("gpt-4o-mini")
  temperature           Float      @default(0.3)
  byokApiKeyEncrypted   String?
  isActive              Boolean    @default(true)
  autoEscalateOnUnknown Boolean    @default(true)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model FaqItem {
  id        String   @id @default(cuid())
  tenantId  String
  question  String
  answer    String
  category  String   @default("General")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model KnowledgeDocument {
  id           String             @id @default(cuid())
  tenantId     String
  title        String
  sourceType   DocumentSourceType
  sourceUrl    String?
  rawContent   String
  status       DocumentStatus     @default(PROCESSING)
  errorMessage String?
  chunkCount   Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chunks KnowledgeChunk[]

  @@index([tenantId])
}

model KnowledgeChunk {
  id           String                      @id @default(cuid())
  tenantId     String
  documentId   String
  chunkIndex   Int
  content      String
  embedding    Unsupported("vector(1536)")?
  metadataJson Json?
  createdAt    DateTime                    @default(now())

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([documentId])
}

model ChannelConnection {
  id                   String      @id @default(cuid())
  tenantId             String
  type                 ChannelType
  name                 String
  isActive             Boolean     @default(true)
  externalAccountId    String?
  phoneNumberId        String?
  pageId               String?
  accessTokenEncrypted String?
  webhookVerifyToken   String?
  widgetConfigJson     Json?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type])
  @@index([tenantId])
}

model Contact {
  id          String   @id @default(cuid())
  tenantId    String
  name        String?
  email       String?
  phone       String?
  whatsappId  String?
  instagramId String?
  messengerId String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  appointments  Appointment[]

  @@index([tenantId])
  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@index([tenantId, whatsappId])
}

model Conversation {
  id                  String             @id @default(cuid())
  tenantId            String
  contactId           String
  channel             ChannelType        @default(WEB)
  externalThreadId    String?
  status              ConversationStatus @default(AI_ACTIVE)
  needsHumanAttention Boolean            @default(false)
  handoffReason       String?
  assignedUserId      String?
  lastMessageAt       DateTime           @default(now())
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact      Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedUser User?         @relation("AssignedAgent", fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages     Message[]
  appointments Appointment[]

  @@index([tenantId, lastMessageAt])
  @@index([tenantId, status])
  @@index([tenantId, externalThreadId])
}

model Message {
  id                String      @id @default(cuid())
  tenantId          String
  conversationId    String
  role              MessageRole
  content           String
  toolCallsJson     Json?
  tokensInput       Int         @default(0)
  tokensOutput      Int         @default(0)
  provider          AiProvider?
  model             String?
  externalMessageId String?
  createdAt         DateTime    @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([tenantId, createdAt])
}

model Service {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  durationMinutes Int      @default(30)
  priceCents      Int      @default(0)
  currency        String   @default("MXN")
  color           String   @default("#4f46e5")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([tenantId])
}

model AvailabilityRule {
  id        String   @id @default(cuid())
  tenantId  String
  dayOfWeek Int // 0 = Domingo, 1 = Lunes ... 6 = Sábado
  startTime String // "09:00"
  endTime   String // "18:00"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dayOfWeek])
  @@index([tenantId])
}

model AvailabilityException {
  id              String   @id @default(cuid())
  tenantId        String
  date            String // "YYYY-MM-DD"
  isBlocked       Boolean  @default(true)
  customStartTime String?
  customEndTime   String?
  reason          String?
  createdAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@index([tenantId])
}

model GoogleCalendarConnection {
  id                    String    @id @default(cuid())
  tenantId              String    @unique
  googleEmail           String?
  calendarId            String    @default("primary")
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  syncEnabled           Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Appointment {
  id                 String            @id @default(cuid())
  tenantId           String
  contactId          String
  serviceId          String
  conversationId     String?
  startsAt           DateTime
  endsAt             DateTime
  status             AppointmentStatus @default(CONFIRMED)
  notes              String?
  cancellationReason String?
  googleEventId      String?
  reminderSentAt     DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact      Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([tenantId, startsAt])
  @@index([tenantId, status])
  @@index([contactId])
}

model UsageRecord {
  id                  String   @id @default(cuid())
  tenantId            String
  month               String // "YYYY-MM"
  messagesCount       Int      @default(0)
  tokensInput         Int      @default(0)
  tokensOutput        Int      @default(0)
  appointmentsCreated Int      @default(0)
  aiResolvedCount     Int      @default(0)
  humanHandoffCount   Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, month])
  @@index([tenantId])
}

model NotificationRule {
  id                       String   @id @default(cuid())
  tenantId                 String   @unique
  notifyOnBooking          Boolean  @default(true)
  notifyOnCancellation     Boolean  @default(true)
  notifyOnHandoff          Boolean  @default(true)
  sendAppointmentReminders Boolean  @default(true)
  reminderHoursBefore      Int      @default(24)
  emailRecipients          String   @default("") // coma-separado
  whatsappRecipients       String   @default("") // coma-separado
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model NotificationLog {
  id           String              @id @default(cuid())
  tenantId     String
  type         NotificationType
  channel      NotificationChannel
  recipient    String
  subject      String?
  body         String
  status       NotificationStatus
  errorMessage String?
  createdAt    DateTime            @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

model BillingEvent {
  id           String    @id @default(cuid())
  tenantId     String
  provider     String    @default("MERCADOPAGO")
  eventType    String
  externalId   String?
  planCode     PlanCode?
  amountCents  Int       @default(0)
  currency     String    @default("MXN")
  status       String    @default("PROCESSED")
  metadataJson Json?
  createdAt    DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

model TenantInvitation {
  id         String     @id @default(cuid())
  tenantId   String
  email      String
  role       TenantRole @default(AGENT)
  token      String     @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime   @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([email])
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  token     String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}
