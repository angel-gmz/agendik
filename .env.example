# Base de datos PostgreSQL con pgvector
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agente_ia?schema=public"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change-me-strong-password"
POSTGRES_DB="agente_ia"
RUN_DB_PUSH="true"

# Dominio base para subdominios multi-tenant (en producción: tudominio.com y https://tudominio.com)
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Seguridad (OBLIGATORIO generar valores aleatorios en producción)
# Generar con: openssl rand -hex 32
AUTH_SECRET="dev-auth-secret-change-in-production-32chars!!"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
CRON_SECRET="dev-cron-secret-change-me"

# Proveedores de IA centrales de la plataforma
OPENAI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""
DEFAULT_AI_PROVIDER="OPENAI"
DEFAULT_OPENAI_MODEL="gpt-4o-mini"
DEFAULT_GOOGLE_MODEL="gemini-2.0-flash"

# Meta Cloud API (WhatsApp / Instagram / Messenger)
# META_APP_SECRET es obligatorio en producción para validar firmas x-hub-signature-256
META_APP_SECRET=""
# Plantilla aprobada en Meta para recordatorios fuera de ventana 24h (opcional)
WHATSAPP_REMINDER_TEMPLATE_NAME=""
WHATSAPP_REMINDER_TEMPLATE_LANG="es_MX"

# Google Calendar OAuth2 (opcional por plataforma)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://tudominio.com/api/integrations/google/callback"

# Notificaciones y correos transaccionales (SMTP real recomendado: Resend, Brevo, Postmark)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Agente IA <noreply@tudominio.com>"

# Mercado Pago Suscripciones (MP_WEBHOOK_SECRET obligatorio en producción si MP_ACCESS_TOKEN está activo)
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""
MP_CURRENCY="MXN"

# Rate Limiting distribuido con Upstash Redis (recomendado en producción)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
